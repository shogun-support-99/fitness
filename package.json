{
  "name": "ironlog",
  "version": "1.0.0",
  "private": true,
  "description": "A private, offline-first strength training log. Static site, no build required to serve; Tailwind is compiled ahead of time into committed CSS.",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.css --minify",
    "test": "node --test \"tests/*.test.js\"",
    "check": "node scripts/check-links.mjs",
    "lint:design": "node .agents/skills/design-taste-frontend/scripts/lint.mjs index.html 404.html assets src",
    "lint:design:app": "node .agents/skills/design-taste-frontend/scripts/lint.mjs --app app/index.html app/css app/js"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  },
  "license": "MIT"
}
