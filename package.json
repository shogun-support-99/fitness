{
  "name": "ironlog",
  "version": "1.0.96",
  "private": true,
  "description": "A private, offline-first strength training log. Static site, no build required to serve; Tailwind is compiled ahead of time into committed CSS.",
  "type": "module",
  "scripts": {
    "build": "npm run build:scene && npm run build:css",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./assets/css/tailwind.css --minify",
    "build:scene": "node scripts/build-scene.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "check": "node scripts/check-links.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.17"
  },
  "license": "MIT",
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/three": "^0.187.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  }
}
