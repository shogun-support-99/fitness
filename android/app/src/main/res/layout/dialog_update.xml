<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_update_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:text="IRONLOG · UPDATE"
        android:textColor="#5F655B"
        android:textSize="10sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="A new build is ready."
        android:textColor="#12140F"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/update_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="#1F5C3F"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/update_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingExtra="3dp"
        android:textColor="#2F332C"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#E4EDE3"
        android:padding="12dp"
        android:text="Your workouts and settings stay on this phone. Updating replaces the app, not your log."
        android:textColor="#0F3D26"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/update_later"
            style="@style/Widget.IronLog.Outline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Later" />

        <Button
            android:id="@+id/update_now"
            style="@style/Widget.IronLog.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="Update now" />
    </LinearLayout>
</LinearLayout>
