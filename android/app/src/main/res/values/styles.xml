<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.IronLog" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ironlog_paper</item>
        <item name="android:statusBarColor">@color/ironlog_forest</item>
        <item name="android:navigationBarColor">@color/ironlog_paper</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/ironlog_signal</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Widget.IronLog.Button" parent="android:style/Widget.Material.Button">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
    </style>

    <style name="Widget.IronLog.Primary" parent="Widget.IronLog.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/ironlog_signal</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.IronLog.Outline" parent="Widget.IronLog.Button">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">#12140F</item>
    </style>
</resources>
